# Local runs only (copy to .env). On AWS these are Lambda environment variables set by template.yaml.
# No credentials here once seeded: they live only in Secrets Manager.

# AWS CLI profile signed in with `aws login`
AWS_PROFILE=qbo-sheets-etl
AWS_REGION=us-east-2

QBO_SECRET_ID=qbo-sheets-etl/qbo
GOOGLE_SECRET_ID=qbo-sheets-etl/google
# the BackupBucketName stack output after `sam deploy`
BACKUP_BUCKET=
# from the sheet's URL: docs.google.com/spreadsheets/d/<ID>/edit
SPREADSHEET_ID=

QBO_ENVIRONMENT=sandbox
TIMEZONE=America/New_York

# only until scripts/seed_secrets.py moves them into Secrets Manager (it removes them from here)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=